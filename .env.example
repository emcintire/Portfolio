# Backblaze B2 — read-only application key, ideally scoped to the photos bucket.
#
# Required even though the bucket is public: B2 allows anonymous download but
# has no anonymous-list, so enumerating a folder needs authorization. These are
# read server-side only (src/lib/b2.ts is `server-only`) and never reach the
# browser, so they must NOT be prefixed NEXT_PUBLIC_.
#
# Locally: copy to .env.local and fill in.
# On Amplify: App settings -> Environment variables.
#
# Without these the site still builds; galleries just render empty.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

# Only for scripts/optimize-bucket.mjs, which rewrites files in place.
# Needs writeFiles + deleteFiles; keep the app's key above read-only.
# Falls back to B2_KEY_ID / B2_APP_KEY if unset.
B2_WRITE_KEY_ID=
B2_WRITE_APP_KEY=
